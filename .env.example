# Redis (required for Publish/Save to work) — added automatically when you
# install the "Upstash for Redis" integration from the Vercel dashboard
# (Storage → Marketplace) and link it to this project. Run
# `vercel env pull .env.local` to copy the real values down locally.
# Only one of these two pairs will actually be set — the code checks both
# naming conventions, since it depends on how the integration names them.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: require this exact value in an X-Builder-Access-Code header to
# publish a new card (stops random visitors from spamming your Redis).
# Leave unset to keep publishing fully open. Never required to view or edit
# an already-published card — the edit link itself is that authorization.
BUILDER_ACCESS_CODE=
